{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Iskra personalization foundation v1",
  "type": "object", "additionalProperties": false, "required": ["schema"],
  "properties": {
    "schema": {"const": 1},
    "avatar": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"},
    "theme": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"},
    "reduced_motion": {"type": "boolean"}
  }
}
