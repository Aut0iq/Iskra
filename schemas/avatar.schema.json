{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Iskra declarative avatar v1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "id", "name", "author", "license", "attribution", "mode"],
  "properties": {
    "format": {"const": "iskra-avatar:v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 1024},
    "author": {"type": "string", "minLength": 1, "maxLength": 1024},
    "license": {"type": "string", "minLength": 1, "maxLength": 1024},
    "attribution": {"type": "string", "minLength": 1, "maxLength": 1024},
    "mode": {"enum": ["portrait", "animated"]},
    "personalization": {
      "type": "object", "additionalProperties": false, "required": ["schema"],
      "properties": {"schema": {"const": 1}, "theme": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"}}
    }
  }
}
