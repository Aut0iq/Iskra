#!/usr/bin/env python3
"""Local feedback only; GitHub rules remain authoritative."""
import sys

for line in sys.stdin:
    local, local_sha, remote, remote_sha = line.split()
    if remote == 'refs/heads/main':
        sys.exit('Iskra: main receives dev only through CI/PR. Direct push is disabled.')
    if remote.startswith('refs/tags/'):
        sys.exit('Iskra: CI creates tags. Dispatch the release workflow instead.')
    if remote == 'refs/heads/dev':
        sys.exit('Iskra: dev receives changes through pull requests. Direct push is disabled.')
